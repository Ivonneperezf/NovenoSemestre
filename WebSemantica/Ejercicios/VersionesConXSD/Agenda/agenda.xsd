<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Elemento raíz -->
    <xs:element name="agenda">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="contacto" type="contactoType" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Definición de contacto -->
    <xs:complexType name="contactoType">
        <xs:sequence>
            <xs:element name="telefono" type="telefonoType" minOccurs="1" maxOccurs="unbounded"/>
            <xs:element name="correo" type="correoType" minOccurs="1" maxOccurs="unbounded"/>
            <xs:element name="direccion" type="direccionType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="nombre" type="xs:string" use="required"/>
        <xs:attribute name="apellido" type="xs:string" use="required"/>
        <xs:attribute name="fechaNacimiento" type="xs:date" use="optional"/>
        <xs:attribute name="nickname" type="xs:string" use="optional"/>
        <xs:attribute name="grupo" type="grupoType" use="optional"/>
    </xs:complexType>

    <!-- Teléfono -->
    <xs:complexType name="telefonoType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="tipo" use="optional" default="movil">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="casa"/>
                            <xs:enumeration value="movil"/>
                            <xs:enumeration value="trabajo"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Correo -->
    <xs:complexType name="correoType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="tipo" use="optional" default="personal">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="personal"/>
                            <xs:enumeration value="trabajo"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Dirección -->
    <xs:complexType name="direccionType">
        <xs:sequence>
            <xs:element name="calle" type="xs:string"/>
            <xs:element name="ciudad" type="xs:string"/>
            <xs:element name="estado" type="xs:string"/>
            <xs:element name="codigoPostal" type="xs:string"/>
            <xs:element name="pais" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Tipo de grupo -->
    <xs:simpleType name="grupoType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Amigos"/>
            <xs:enumeration value="Familia"/>
            <xs:enumeration value="Trabajo"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>