<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <!-- Elemento raíz -->
    <xs:element name="familia">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="integrante" type="personaType" maxOccurs="unbounded"/>
                <xs:element name="relaciones" type="relacionesType" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="apellido" type="xs:string" use="required"/>
            <xs:attribute name="origen" type="xs:string" use="optional"/>
        </xs:complexType>
    </xs:element>

    <!-- Tipo base para persona -->
    <xs:complexType name="personaBaseType">
        <xs:sequence>
            <xs:element name="nombre" type="xs:string"/>
            <xs:element name="fechaNacimiento" type="xs:date"/>
            <xs:element name="fechaDefuncion" type="xs:date" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="genero" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="M"/>
                    <xs:enumeration value="F"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <!-- Herencia: Hombre -->
    <xs:complexType name="hombreType">
        <xs:complexContent>
            <xs:extension base="personaBaseType">
                <xs:sequence>
                    <xs:element name="profesion" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- Herencia: Mujer -->
    <xs:complexType name="mujerType">
        <xs:complexContent>
            <xs:extension base="personaBaseType">
                <xs:sequence>
                    <xs:element name="ocupacion" type="xs:string" minOccurs="0"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- Tipo abstracto: persona (puede ser hombre o mujer) -->
    <xs:complexType name="personaType">
        <xs:choice>
            <xs:element name="hombre" type="hombreType"/>
            <xs:element name="mujer" type="mujerType"/>
        </xs:choice>
    </xs:complexType>

    <!-- Relaciones familiares -->
    <xs:complexType name="relacionesType">
        <xs:sequence>
            <xs:element name="relacion" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:attribute name="tipo" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="padre"/>
                                <xs:enumeration value="madre"/>
                                <xs:enumeration value="hijo"/>
                                <xs:enumeration value="hija"/>
                                <xs:enumeration value="conyuge"/>
                                <xs:enumeration value="hermano"/>
                                <xs:enumeration value="hermana"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="de" type="xs:IDREF" use="required"/>
                    <xs:attribute name="a" type="xs:IDREF" use="required"/>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
