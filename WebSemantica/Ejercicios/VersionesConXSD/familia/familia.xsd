<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Tipo de Dirección -->
  <xs:complexType name="DireccionType">
    <xs:sequence>
      <xs:element name="Calle" type="xs:string" minOccurs="0"/>
      <xs:element name="Ciudad" type="xs:string" minOccurs="0"/>
      <xs:element name="Pais" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Tipo de Contacto -->
  <xs:complexType name="ContactoType">
    <xs:sequence>
      <xs:element name="Telefono" type="xs:string" minOccurs="0"/>
      <xs:element name="Email" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Tipo de Persona -->
  <xs:complexType name="PersonaType">
    <xs:sequence>
      <xs:element name="Nombre" type="xs:string"/>
      <xs:element name="Apellido" type="xs:string"/>
      <xs:element name="Padre" type="xs:IDREF" minOccurs="0"/>
      <xs:element name="Madre" type="xs:IDREF" minOccurs="0"/>
      <xs:element name="Direccion" type="DireccionType" minOccurs="0"/>
      <xs:element name="Contacto" type="ContactoType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Ocupacion" type="xs:string" minOccurs="0"/>
      <xs:element name="Estudios" type="xs:string" minOccurs="0"/>
      <xs:element name="Nota" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="genero" type="xs:string" use="required"/>
    <xs:attribute name="fechaNacimiento" type="xs:date" use="required"/>
    <xs:attribute name="correo" type="xs:string" use="optional"/>
    <xs:attribute name="telefono" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- Tipo de Matrimonio -->
  <xs:complexType name="MatrimonioType">
    <xs:sequence>
      <xs:element name="Conyuge1" type="xs:IDREF"/>
      <xs:element name="Conyuge2" type="xs:IDREF"/>
    </xs:sequence>
    <xs:attribute name="fechaInicio" type="xs:date" use="optional"/>
  </xs:complexType>

  <!-- Elemento raíz -->
  <xs:element name="ArbolGenealogico">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Persona" type="PersonaType" maxOccurs="unbounded"/>
        <xs:element name="Matrimonio" type="MatrimonioType" maxOccurs="unbounded" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>