<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rec="http://example.org/recetas#">

  <!-- Receta 1 -->
  <rdf:Description rdf:about="http://example.org/recetas#EnsaladaCesar">
    <rec:nombre>Ensalada César</rec:nombre>
    <rec:tipo>ensalada</rec:tipo>
    <rec:dificultad>fácil</rec:dificultad>
    <rec:tiempoPreparacion>15</rec:tiempoPreparacion>
    <rec:porciones>2</rec:porciones>
    <rec:categoria>Ensalada</rec:categoria>
    <rec:origen>Internacional</rec:origen>

    <rec:ingredientes>
      <rdf:Bag>
        <rdf:li>Lechuga romana (100 g)</rdf:li>
        <rdf:li>Queso parmesano (50 g)</rdf:li>
        <rdf:li>Croutons (50 g)</rdf:li>
        <rdf:li>Aderezo César (30 ml)</rdf:li>
      </rdf:Bag>
    </rec:ingredientes>

    <rec:preparacion>
      <rdf:Seq>
        <rdf:li>Lavar y cortar la lechuga.</rdf:li>
        <rdf:li>Agregar croutons y queso parmesano.</rdf:li>
        <rdf:li>Verter el aderezo y mezclar.</rdf:li>
      </rdf:Seq>
    </rec:preparacion>
  </rdf:Description>

  <!-- Receta 2 -->
  <rdf:Description rdf:about="http://example.org/recetas#SpaghettiBolonesa">
    <rec:nombre>Spaghetti a la Boloñesa</rec:nombre>
    <rec:tipo>pasta</rec:tipo>
    <rec:dificultad>media</rec:dificultad>
    <rec:tiempoPreparacion>45</rec:tiempoPreparacion>
    <rec:porciones>4</rec:porciones>
    <rec:categoria>Pasta</rec:categoria>
    <rec:origen>Italia</rec:origen>

    <rec:ingredientes>
      <rdf:Bag>
        <rdf:li>Spaghetti (400 g)</rdf:li>
        <rdf:li>Carne molida (300 g)</rdf:li>
        <rdf:li>Salsa de tomate (200 ml)</rdf:li>
        <rdf:li>Aceite de oliva (1 cucharadita)</rdf:li>
      </rdf:Bag>
    </rec:ingredientes>

    <rec:preparacion>
      <rdf:Seq>
        <rdf:li>Cocer la pasta según instrucciones.</rdf:li>
        <rdf:li>Dorar la carne con aceite y agregar salsa de tomate.</rdf:li>
        <rdf:li>Mezclar la pasta con la salsa y servir.</rdf:li>
      </rdf:Seq>
    </rec:preparacion>
  </rdf:Description>

  <!-- Receta 3 -->
  <rdf:Description rdf:about="http://example.org/recetas#TacosPollo">
    <rec:nombre>Tacos de Pollo</rec:nombre>
    <rec:tipo>comida rápida</rec:tipo>
    <rec:dificultad>fácil</rec:dificultad>
    <rec:tiempoPreparacion>25</rec:tiempoPreparacion>
    <rec:porciones>3</rec:porciones>
    <rec:categoria>Mexicana</rec:categoria>
    <rec:origen>México</rec:origen>

    <rec:ingredientes>
      <rdf:Bag>
        <rdf:li>Pechuga de pollo (300 g)</rdf:li>
        <rdf:li>Tortillas (6 unidad)</rdf:li>
        <rdf:li>Lechuga (50 g)</rdf:li>
        <rdf:li>Queso rallado (50 g)</rdf:li>
      </rdf:Bag>
    </rec:ingredientes>

    <rec:preparacion>
      <rdf:Seq>
        <rdf:li>Cocinar el pollo y cortarlo en tiras.</rdf:li>
        <rdf:li>Calentar las tortillas.</rdf:li>
        <rdf:li>Rellenar las tortillas con pollo, lechuga y queso.</rdf:li>
      </rdf:Seq>
    </rec:preparacion>
  </rdf:Description>

  <!-- Receta 4 -->
  <rdf:Description rdf:about="http://example.org/recetas#SmoothiePlatanoFresa">
    <rec:nombre>Smoothie de Plátano y Fresa</rec:nombre>
    <rec:tipo>bebida</rec:tipo>
    <rec:dificultad>fácil</rec:dificultad>
    <rec:tiempoPreparacion>10</rec:tiempoPreparacion>
    <rec:porciones>2</rec:porciones>
    <rec:categoria>Bebida</rec:categoria>
    <rec:origen>Internacional</rec:origen>

    <rec:ingredientes>
      <rdf:Bag>
        <rdf:li>Plátano (1 unidad)</rdf:li>
        <rdf:li>Fresas (150 g)</rdf:li>
        <rdf:li>Leche (200 ml)</rdf:li>
      </rdf:Bag>
    </rec:ingredientes>

    <rec:preparacion>
      <rdf:Seq>
        <rdf:li>Lavar y cortar las frutas.</rdf:li>
        <rdf:li>Licuar las frutas con la leche hasta obtener mezcla homogénea.</rdf:li>
        <rdf:li>Servir frío.</rdf:li>
      </rdf:Seq>
    </rec:preparacion>
  </rdf:Description>

  <!-- Receta 5 -->
  <rdf:Description rdf:about="http://example.org/recetas#OmeletteQueso">
    <rec:nombre>Omelette de Queso</rec:nombre>
    <rec:tipo>desayuno</rec:tipo>
    <rec:dificultad>fácil</rec:dificultad>
    <rec:tiempoPreparacion>10</rec:tiempoPreparacion>
    <rec:porciones>1</rec:porciones>
    <rec:categoria>Desayuno</rec:categoria>
    <rec:origen>Internacional</rec:origen>

    <rec:ingredientes>
      <rdf:Bag>
        <rdf:li>Huevos (2 unidad)</rdf:li>
        <rdf:li>Queso (50 g)</rdf:li>
        <rdf:li>Aceite (1 cucharadita)</rdf:li>
      </rdf:Bag>
    </rec:ingredientes>

    <rec:preparacion>
      <rdf:Seq>
        <rdf:li>Batir los huevos.</rdf:li>
        <rdf:li>Calentar el aceite en sartén y verter los huevos.</rdf:li>
        <rdf:li>Agregar el queso y doblar el omelette.</rdf:li>
      </rdf:Seq>
    </rec:preparacion>
  </rdf:Description>

  <!-- Receta 6 -->
  <rdf:Description rdf:about="http://example.org/recetas#SopaVerduras">
    <rec:nombre>Sopa de Verduras</rec:nombre>
    <rec:tipo>sopa</rec:tipo>
    <rec:dificultad>media</rec:dificultad>
    <rec:tiempoPreparacion>40</rec:tiempoPreparacion>
    <rec:porciones>4</rec:porciones>
    <rec:categoria>Sopa</rec:categoria>
    <rec:origen>Internacional</rec:origen>

    <rec:ingredientes>
      <rdf:Bag>
        <rdf:li>Zanahorias (2 unidad)</rdf:li>
        <rdf:li>Papas (2 unidad)</rdf:li>
        <rdf:li>Cebolla (1 unidad)</rdf:li>
        <rdf:li>Agua (1 litro)</rdf:li>
      </rdf:Bag>
    </rec:ingredientes>

    <rec:preparacion>
      <rdf:Seq>
        <rdf:li>Pelar y cortar las verduras.</rdf:li>
        <rdf:li>Hervir agua y añadir verduras.</rdf:li>
        <rdf:li>Cocinar 30 minutos y servir caliente.</rdf:li>
      </rdf:Seq>
    </rec:preparacion>
  </rdf:Description>

  <!-- Receta 7 -->
  <rdf:Description rdf:about="http://example.org/recetas#PizzaMargarita">
    <rec:nombre>Pizza Margarita</rec:nombre>
    <rec:tipo>comida rápida</rec:tipo>
    <rec:dificultad>media</rec:dificultad>
    <rec:tiempoPreparacion>50</rec:tiempoPreparacion>
    <rec:porciones>4</rec:porciones>
    <rec:categoria>Pizza</rec:categoria>
    <rec:origen>Italia</rec:origen>

    <rec:ingredientes>
      <rdf:Bag>
        <rdf:li>Masa para pizza (300 g)</rdf:li>
        <rdf:li>Queso mozzarella (100 g)</rdf:li>
        <rdf:li>Salsa de tomate (50 g)</rdf:li>
        <rdf:li>Albahaca (5 hojas)</rdf:li>
      </rdf:Bag>
    </rec:ingredientes>

    <rec:preparacion>
      <rdf:Seq>
        <rdf:li>Extender la masa y cubrir con salsa de tomate.</rdf:li>
        <rdf:li>Agregar queso y hojas de albahaca.</rdf:li>
        <rdf:li>Hornear 20 minutos a 200°C.</rdf:li>
      </rdf:Seq>
    </rec:preparacion>
  </rdf:Description>

  <!-- Receta 8 -->
  <rdf:Description rdf:about="http://example.org/recetas#BrowniesChocolate">
    <rec:nombre>Brownies de Chocolate</rec:nombre>
    <rec:tipo>postre</rec:tipo>
    <rec:dificultad>media</rec:dificultad>
    <rec:tiempoPreparacion>35</rec:tiempoPreparacion>
    <rec:porciones>8</rec:porciones>
    <rec:categoria>Postre</rec:categoria>
    <rec:origen>Internacional</rec:origen>

    <rec:ingredientes>
      <rdf:Bag>
        <rdf:li>Chocolate (200 g)</rdf:li>
        <rdf:li>Mantequilla (150 g)</rdf:li>
        <rdf:li>Azúcar (150 g)</rdf:li>
        <rdf:li>Huevos (3 unidad)</rdf:li>
        <rdf:li>Harina (100 g)</rdf:li>
      </rdf:Bag>
    </rec:ingredientes>

    <rec:preparacion>
      <rdf:Seq>
        <rdf:li>Derretir chocolate y mantequilla juntos.</rdf:li>
        <rdf:li>Mezclar con azúcar y huevos.</rdf:li>
        <rdf:li>Agregar harina y mezclar bien.</rdf:li>
        <rdf:li>Hornear 25 minutos a 180°C.</rdf:li>
      </rdf:Seq>
    </rec:preparacion>
  </rdf:Description>

</rdf:RDF>