    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#associatedRelative</IRI>
        <Literal>Relación que indica el familiar al que corresponde una historia médica familiar registrada.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#associatedResult</IRI>
        <Literal>Relación que indica el resultado estructurado asociado a un test clínico específico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasAddress</IRI>
        <Literal>Relación que indica la dirección asociada a una persona, ya sea paciente, familiar o profesional.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasFamilyHistory</IRI>
        <Literal>Relación que indica la historia médica familiar asociada a un paciente, incluyendo condiciones hereditarias y vínculos genéticos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasGene</IRI>
        <Literal>Relación que indica los genes presentes en el genoma de un paciente, relevantes para análisis clínico o diagnóstico molecular.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasMolecularDiagnosticTestResult</IRI>
        <Literal>Relación que indica los resultados de pruebas moleculares asociados a un paciente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasMutation</IRI>
        <Literal>Relación que indica las mutaciones genéticas presentes en un paciente, relevantes para su perfil clínico o diagnóstico molecular.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasPatient</IRI>
        <Literal>Relación que indica el paciente al que pertenece un resultado estructurado de prueba.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasStructuredTestResult</IRI>
        <Literal>Relación que indica los resultados estructurados de pruebas clínicas asociados a un paciente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#identifiesMutation</IRI>
        <Literal>Relación que indica la mutación genética identificada por un resultado de prueba molecular.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#indicatesDisease</IRI>
        <Literal>Relación que indica la enfermedad sugerida o confirmada por un resultado de prueba molecular.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isMutationOf</IRI>
        <Literal>Relación que indica el gen en el cual ocurre una mutación específica.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#isRelatedTo</IRI>
        <Literal>Relación que indica el vínculo familiar entre un paciente y una persona clasificada como su familiar.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#payorAddress</IRI>
        <Literal>Relación que indica la dirección del pagador asociada a una orden de laboratorio.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#recipientAddress</IRI>
        <Literal>Relación que indica la dirección del destinatario asociada a una orden de laboratorio.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#suffersFrom</IRI>
        <Literal>Relación que indica las enfermedades que padece un paciente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#test</IRI>
        <Literal>Relación que indica los tests que forman parte de un panel clínico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#testPanel</IRI>
        <Literal>Relación que indica qué panel de pruebas está incluido en una orden de laboratorio.</Literal>
    </AnnotationAssertion>
</Ontology>



