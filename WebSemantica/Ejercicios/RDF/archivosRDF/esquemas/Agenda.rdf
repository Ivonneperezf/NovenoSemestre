<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:agd="http://example.org/agenda#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <!-- ==================== CLASES ==================== -->
    
    <!-- Clase Contacto -->
    <rdfs:Class rdf:about="http://example.org/agenda#Contacto">
        <rdfs:label xml:lang="es">Contacto</rdfs:label>
        <rdfs:comment xml:lang="es">Representa una persona en la agenda de contactos</rdfs:comment>
    </rdfs:Class>

    <!-- Clase Direccion -->
    <rdfs:Class rdf:about="http://example.org/agenda#Direccion">
        <rdfs:label xml:lang="es">Dirección</rdfs:label>
        <rdfs:comment xml:lang="es">Representa una dirección postal completa</rdfs:comment>
    </rdfs:Class>

    <!-- ==================== PROPIEDADES DE CONTACTO ==================== -->
    
    <!-- Propiedad: nombre -->
    <rdf:Property rdf:about="http://example.org/agenda#nombre">
        <rdfs:label xml:lang="es">nombre</rdfs:label>
        <rdfs:comment xml:lang="es">Nombre de pila del contacto</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Contacto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: apellido -->
    <rdf:Property rdf:about="http://example.org/agenda#apellido">
        <rdfs:label xml:lang="es">apellido</rdfs:label>
        <rdfs:comment xml:lang="es">Apellido del contacto</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Contacto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: fechaNacimiento -->
    <rdf:Property rdf:about="http://example.org/agenda#fechaNacimiento">
        <rdfs:label xml:lang="es">fecha de nacimiento</rdfs:label>
        <rdfs:comment xml:lang="es">Fecha de nacimiento del contacto</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Contacto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </rdf:Property>

    <!-- Propiedad: nickname -->
    <rdf:Property rdf:about="http://example.org/agenda#nickname">
        <rdfs:label xml:lang="es">apodo</rdfs:label>
        <rdfs:comment xml:lang="es">Apodo o nombre corto del contacto</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Contacto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: grupo -->
    <rdf:Property rdf:about="http://example.org/agenda#grupo">
        <rdfs:label xml:lang="es">grupo</rdfs:label>
        <rdfs:comment xml:lang="es">Categoría o grupo al que pertenece el contacto (Familia, Amigos, Trabajo, etc.)</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Contacto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: telefonos -->
    <rdf:Property rdf:about="http://example.org/agenda#telefonos">
        <rdfs:label xml:lang="es">teléfonos</rdfs:label>
        <rdfs:comment xml:lang="es">Colección de números telefónicos del contacto</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Contacto"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Bag"/>
    </rdf:Property>

    <!-- Propiedad: correos -->
    <rdf:Property rdf:about="http://example.org/agenda#correos">
        <rdfs:label xml:lang="es">correos electrónicos</rdfs:label>
        <rdfs:comment xml:lang="es">Colección de direcciones de correo electrónico del contacto</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Contacto"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Bag"/>
    </rdf:Property>

    <!-- Propiedad: residenEn (relación) -->
    <rdf:Property rdf:about="http://example.org/agenda#residenEn">
        <rdfs:label xml:lang="es">residen en</rdfs:label>
        <rdfs:comment xml:lang="es">Relaciona un contacto con su dirección postal donde reside</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Contacto"/>
        <rdfs:range rdf:resource="http://example.org/agenda#Direccion"/>
    </rdf:Property>

    <!-- ==================== PROPIEDADES DE DIRECCION ==================== -->
    
    <!-- Propiedad: calle -->
    <rdf:Property rdf:about="http://example.org/agenda#calle">
        <rdfs:label xml:lang="es">calle</rdfs:label>
        <rdfs:comment xml:lang="es">Nombre de la calle y número</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: ciudad -->
    <rdf:Property rdf:about="http://example.org/agenda#ciudad">
        <rdfs:label xml:lang="es">ciudad</rdfs:label>
        <rdfs:comment xml:lang="es">Ciudad de la dirección</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: estado -->
    <rdf:Property rdf:about="http://example.org/agenda#estado">
        <rdfs:label xml:lang="es">estado</rdfs:label>
        <rdfs:comment xml:lang="es">Estado o provincia de la dirección</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: codigoPostal -->
    <rdf:Property rdf:about="http://example.org/agenda#codigoPostal">
        <rdfs:label xml:lang="es">código postal</rdfs:label>
        <rdfs:comment xml:lang="es">Código postal de la dirección</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: pais -->
    <rdf:Property rdf:about="http://example.org/agenda#pais">
        <rdfs:label xml:lang="es">país</rdfs:label>
        <rdfs:comment xml:lang="es">País de la dirección</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/agenda#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- ==================== INSTANCIAS - CONTACTOS ==================== -->

    <!-- CONTACTO 1 -->
    <agd:Contacto rdf:about="http://example.org/agenda/contacto/emilia-rosas">
        <agd:nombre>Emilia</agd:nombre>
        <agd:apellido>Rosas</agd:apellido>
        <agd:fechaNacimiento rdf:datatype="xsd:date">1995-08-21</agd:fechaNacimiento>
        <agd:nickname>EmR</agd:nickname>
        <agd:grupo>Amigos</agd:grupo>

        <agd:telefonos>
            <rdf:Bag>
                <rdf:li>movil: 5551234567</rdf:li>
                <rdf:li>casa: 559876543</rdf:li>
            </rdf:Bag>
        </agd:telefonos>

        <agd:correos>
            <rdf:Bag>
                <rdf:li>personal: emi.ros@mail.com</rdf:li>
                <rdf:li>trabajo: emi.ros@empresa.com</rdf:li>
            </rdf:Bag>
        </agd:correos>

        <agd:residenEn>
            <agd:Direccion>
                <agd:calle>Av. Reforma 123</agd:calle>
                <agd:ciudad>Ciudad de México</agd:ciudad>
                <agd:estado>CDMX</agd:estado>
                <agd:codigoPostal rdf:datatype="xsd:string">01234</agd:codigoPostal>
                <agd:pais>México</agd:pais>
            </agd:Direccion>
        </agd:residenEn>
    </agd:Contacto>

    <!-- CONTACTO 2 -->
    <agd:Contacto rdf:about="http://example.org/agenda/contacto/carlos-ramirez">
        <agd:nombre>Carlos</agd:nombre>
        <agd:apellido>Ramírez</agd:apellido>
        <agd:fechaNacimiento rdf:datatype="xsd:date">2001-02-15</agd:fechaNacimiento>
        <agd:grupo>Trabajo</agd:grupo>

        <agd:telefonos>
            <rdf:Bag>
                <rdf:li>trabajo: 551122334</rdf:li>
            </rdf:Bag>
        </agd:telefonos>

        <agd:correos>
            <rdf:Bag>
                <rdf:li>trabajo: carlos.ramirez@empresa.com</rdf:li>
            </rdf:Bag>
        </agd:correos>

        <agd:residenEn>
            <agd:Direccion>
                <agd:calle>Calle del Sol 45</agd:calle>
                <agd:ciudad>Guadalajara</agd:ciudad>
                <agd:estado>Jalisco</agd:estado>
                <agd:codigoPostal rdf:datatype="xsd:string">44100</agd:codigoPostal>
                <agd:pais>México</agd:pais>
            </agd:Direccion>
        </agd:residenEn>
    </agd:Contacto>

    <!-- CONTACTO 3 -->
    <agd:Contacto rdf:about="http://example.org/agenda/contacto/maria-gonzalez">
        <agd:nombre>María</agd:nombre>
        <agd:apellido>González</agd:apellido>
        <agd:nickname>MG</agd:nickname>
        <agd:grupo>Familia</agd:grupo>

        <agd:telefonos>
            <rdf:Bag>
                <rdf:li>movil: 5559876543</rdf:li>
            </rdf:Bag>
        </agd:telefonos>

        <agd:correos>
            <rdf:Bag>
                <rdf:li>personal: maria.gonzalez@mail.com</rdf:li>
            </rdf:Bag>
        </agd:correos>
    </agd:Contacto>

    <!-- CONTACTO 4 -->
    <agd:Contacto rdf:about="http://example.org/agenda/contacto/juan-hernandez">
        <agd:nombre>Juan</agd:nombre>
        <agd:apellido>Hernández</agd:apellido>
        <agd:fechaNacimiento rdf:datatype="xsd:date">2008-11-30</agd:fechaNacimiento>
        <agd:grupo>Amigos</agd:grupo>

        <agd:telefonos>
            <rdf:Bag>
                <rdf:li>movil: 5552345678</rdf:li>
            </rdf:Bag>
        </agd:telefonos>

        <agd:correos>
            <rdf:Bag>
                <rdf:li>personal: juan.hernandez@mail.com</rdf:li>
            </rdf:Bag>
        </agd:correos>

        <agd:residenEn>
            <agd:Direccion>
                <agd:calle>Av. Insurgentes 456</agd:calle>
                <agd:ciudad>Ciudad de México</agd:ciudad>
                <agd:estado>CDMX</agd:estado>
                <agd:codigoPostal rdf:datatype="xsd:string">01010</agd:codigoPostal>
                <agd:pais>México</agd:pais>
            </agd:Direccion>
        </agd:residenEn>
    </agd:Contacto>

    <!-- CONTACTO 5 -->
    <agd:Contacto rdf:about="http://example.org/agenda/contacto/ana-martinez">
        <agd:nombre>Ana</agd:nombre>
        <agd:apellido>Martínez</agd:apellido>
        <agd:grupo>Trabajo</agd:grupo>

        <agd:telefonos>
            <rdf:Bag>
                <rdf:li>trabajo: 553344556</rdf:li>
            </rdf:Bag>
        </agd:telefonos>

        <agd:correos>
            <rdf:Bag>
                <rdf:li>trabajo: ana.martinez@empresa.com</rdf:li>
            </rdf:Bag>
        </agd:correos>
    </agd:Contacto>

    <!-- CONTACTO 6 -->
    <agd:Contacto rdf:about="http://example.org/agenda/contacto/luis-torres">
        <agd:nombre>Luis</agd:nombre>
        <agd:apellido>Torres</agd:apellido>
        <agd:fechaNacimiento rdf:datatype="xsd:date">1992-07-10</agd:fechaNacimiento>
        <agd:grupo>Familia</agd:grupo>

        <agd:telefonos>
            <rdf:Bag>
                <rdf:li>movil: 5553456789</rdf:li>
            </rdf:Bag>
        </agd:telefonos>

        <agd:correos>
            <rdf:Bag>
                <rdf:li>personal: luis.torres@mail.com</rdf:li>
            </rdf:Bag>
        </agd:correos>

        <agd:residenEn>
            <agd:Direccion>
                <agd:calle>Calle Luna 789</agd:calle>
                <agd:ciudad>Monterrey</agd:ciudad>
                <agd:estado>Nuevo León</agd:estado>
                <agd:codigoPostal rdf:datatype="xsd:string">64000</agd:codigoPostal>
                <agd:pais>México</agd:pais>
            </agd:Direccion>
        </agd:residenEn>
    </agd:Contacto>

    <!-- CONTACTO 7 -->
    <agd:Contacto rdf:about="http://example.org/agenda/contacto/sofia-vargas">
        <agd:nombre>Sofía</agd:nombre>
        <agd:apellido>Vargas</agd:apellido>
        <agd:nickname>SofiV</agd:nickname>
        <agd:grupo>Amigos</agd:grupo>

        <agd:telefonos>
            <rdf:Bag>
                <rdf:li>movil: 5554567890</rdf:li>
            </rdf:Bag>
        </agd:telefonos>

        <agd:correos>
            <rdf:Bag>
                <rdf:li>personal: sofia.vargas@mail.com</rdf:li>
            </rdf:Bag>
        </agd:correos>
    </agd:Contacto>

</rdf:RDF>