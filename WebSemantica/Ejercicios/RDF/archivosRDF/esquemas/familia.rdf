<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:fam="http://example.org/familia#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <!-- ==================== CLASES ==================== -->
    
    <!-- Clase Persona -->
    <rdfs:Class rdf:about="http://example.org/familia#Persona">
        <rdfs:label xml:lang="es">Persona</rdfs:label>
        <rdfs:comment xml:lang="es">Representa un miembro de la familia</rdfs:comment>
    </rdfs:Class>

    <!-- Clase Direccion -->
    <rdfs:Class rdf:about="http://example.org/familia#Direccion">
        <rdfs:label xml:lang="es">Dirección</rdfs:label>
        <rdfs:comment xml:lang="es">Representa una dirección postal</rdfs:comment>
    </rdfs:Class>

    <!-- Clase Matrimonio -->
    <rdfs:Class rdf:about="http://example.org/familia#Matrimonio">
        <rdfs:label xml:lang="es">Matrimonio</rdfs:label>
        <rdfs:comment xml:lang="es">Representa una unión matrimonial entre dos personas</rdfs:comment>
    </rdfs:Class>

    <!-- ==================== PROPIEDADES DE PERSONA ==================== -->
    
    <rdf:Property rdf:about="http://example.org/familia#nombre">
        <rdfs:label xml:lang="es">nombre</rdfs:label>
        <rdfs:comment xml:lang="es">Nombre de pila de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#apellido">
        <rdfs:label xml:lang="es">apellido</rdfs:label>
        <rdfs:comment xml:lang="es">Apellido(s) de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#genero">
        <rdfs:label xml:lang="es">género</rdfs:label>
        <rdfs:comment xml:lang="es">Género de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#fechaNacimiento">
        <rdfs:label xml:lang="es">fecha de nacimiento</rdfs:label>
        <rdfs:comment xml:lang="es">Fecha de nacimiento de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#telefono">
        <rdfs:label xml:lang="es">teléfono</rdfs:label>
        <rdfs:comment xml:lang="es">Número telefónico de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#correo">
        <rdfs:label xml:lang="es">correo electrónico</rdfs:label>
        <rdfs:comment xml:lang="es">Dirección de correo electrónico de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#direccion">
        <rdfs:label xml:lang="es">dirección</rdfs:label>
        <rdfs:comment xml:lang="es">Dirección postal de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://example.org/familia#Direccion"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#ocupacion">
        <rdfs:label xml:lang="es">ocupación</rdfs:label>
        <rdfs:comment xml:lang="es">Ocupación laboral de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#estudios">
        <rdfs:label xml:lang="es">estudios</rdfs:label>
        <rdfs:comment xml:lang="es">Nivel de estudios o grado académico de la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#nota">
        <rdfs:label xml:lang="es">nota</rdfs:label>
        <rdfs:comment xml:lang="es">Nota o comentario adicional sobre la persona</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#padre">
        <rdfs:label xml:lang="es">padre</rdfs:label>
        <rdfs:comment xml:lang="es">Relación de filiación paterna</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://example.org/familia#Persona"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#madre">
        <rdfs:label xml:lang="es">madre</rdfs:label>
        <rdfs:comment xml:lang="es">Relación de filiación materna</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Persona"/>
        <rdfs:range rdf:resource="http://example.org/familia#Persona"/>
    </rdf:Property>

    <!-- ==================== PROPIEDADES DE DIRECCION ==================== -->
    
    <rdf:Property rdf:about="http://example.org/familia#calle">
        <rdfs:label xml:lang="es">calle</rdfs:label>
        <rdfs:comment xml:lang="es">Nombre de la calle y número</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#ciudad">
        <rdfs:label xml:lang="es">ciudad</rdfs:label>
        <rdfs:comment xml:lang="es">Ciudad de la dirección</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#pais">
        <rdfs:label xml:lang="es">país</rdfs:label>
        <rdfs:comment xml:lang="es">País de la dirección</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- ==================== PROPIEDADES DE MATRIMONIO ==================== -->
    
    <rdf:Property rdf:about="http://example.org/familia#fechaInicio">
        <rdfs:label xml:lang="es">fecha de inicio</rdfs:label>
        <rdfs:comment xml:lang="es">Fecha en que se celebró el matrimonio</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Matrimonio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/familia#estaUnidoA">
        <rdfs:label xml:lang="es">está unido a</rdfs:label>
        <rdfs:comment xml:lang="es">Relaciona el matrimonio con uno de los cónyuges</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/familia#Matrimonio"/>
        <rdfs:range rdf:resource="http://example.org/familia#Persona"/>
    </rdf:Property>

    <!-- ==================== ABUELOS ==================== -->

    <fam:Persona rdf:about="http://example.org/familia#HumbertoFlores">
        <fam:nombre>Humberto</fam:nombre>
        <fam:apellido>Flores</fam:apellido>
        <fam:genero>Masculino</fam:genero>
        <fam:fechaNacimiento rdf:datatype="xsd:date">1945-05-10</fam:fechaNacimiento>
        <fam:telefono>2481000001</fam:telefono>
        <fam:correo>hflores@example.com</fam:correo>
        <fam:residenEn>
            <fam:Direccion>
                <fam:calle>Calle Central 101</fam:calle>
                <fam:ciudad>Puebla</fam:ciudad>
                <fam:pais>México</fam:pais>
            </fam:Direccion>
        </fam:residenEn>
        <fam:ocupacion>Jubilado</fam:ocupacion>
        <fam:estudios>Licenciatura en Contabilidad</fam:estudios>
        <fam:nota>Padre de María Lucía</fam:nota>
    </fam:Persona>

    <fam:Persona rdf:about="http://example.org/familia#GuillerminaUbaldo">
        <fam:nombre>Guillermina</fam:nombre>
        <fam:apellido>Ubaldo</fam:apellido>
        <fam:genero>Femenino</fam:genero>
        <fam:fechaNacimiento rdf:datatype="xsd:date">1947-11-22</fam:fechaNacimiento>
        <fam:telefono>2481000002</fam:telefono>
        <fam:correo>gubaldo@example.com</fam:correo>
        <fam:residenEn>
            <fam:Direccion>
                <fam:calle>Calle Central 101</fam:calle>
                <fam:ciudad>Puebla</fam:ciudad>
                <fam:pais>México</fam:pais>
            </fam:Direccion>
        </fam:residenEn>
        <fam:ocupacion>Ama de casa</fam:ocupacion>
        <fam:estudios>Secundaria completa</fam:estudios>
        <fam:nota>Madre de María Lucía</fam:nota>
    </fam:Persona>

    <!-- ==================== PADRES ==================== -->

    <fam:Persona rdf:about="http://example.org/familia#MariaLuciaFloresUbaldo">
        <fam:nombre>María Lucía</fam:nombre>
        <fam:apellido>Flores Ubaldo</fam:apellido>
        <fam:genero>Femenino</fam:genero>
        <fam:fechaNacimiento rdf:datatype="xsd:date">1972-10-29</fam:fechaNacimiento>
