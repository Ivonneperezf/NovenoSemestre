    <!-- ==================== MATRIMONIOS ==================== -->

    <fam:Matrimonio rdf:about="http://example.org/familia#Matrimonio1">
        <fam:fechaInicio rdf:datatype="xsd:date">1997-06-15</fam:fechaInicio>
        <fam:estaUnidoA rdf:resource="http://example.org/familia#MariaLuciaFloresUbaldo"/>
        <fam:estaUnidoA rdf:resource="http://example.org/familia#YaelPerezMendez"/>
    </fam:Matrimonio>

    <fam:Matrimonio rdf:about="http://example.org/familia#Matrimonio2">
        <fam:fechaInicio rdf:datatype="xsd:date">1962-11-10</fam:fechaInicio>
        <fam:estaUnidoA rdf:resource="http://example.org/familia#HumbertoFlores"/>
        <fam:estaUnidoA rdf:resource="http://example.org/familia#GuillerminaUbaldo"/>
    </fam:Matrimonio>

</rdf:RDF>