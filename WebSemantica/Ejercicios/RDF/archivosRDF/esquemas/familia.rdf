        <fam:tienePadre rdf:resource="http://example.org/familia#HumbertoFlores"/>
        <fam:tieneMadre rdf:resource="http://example.org/familia#GuillerminaUbaldo"/>
        <fam:residenEn>
            <fam:Direccion>
                <fam:calle>Av. Reforma 123</fam:calle>
                <fam:ciudad>Puebla</fam:ciudad>
                <fam:pais>México</fam:pais>
            </fam:Direccion>
        </fam:residenEn>
        <fam:ocupacion>Comerciante</fam:ocupacion>
        <fam:estudios>Licenciatura en Administración</fam:estudios>
