<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF 
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:geo="http://example.org/ontologia/geografia#"
    xml:base="http://example.org/ontologia/geografia#">

  <!--CLASES #############################################################-->
  <rdfs:Class rdf:about="#Region">
    <rdfs:label>Región</rdfs:label>
    <rdfs:comment>Área geográfica con características naturales o políticas comunes</rdfs:comment>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Nacion">
    <rdfs:subClassOf rdf:resource="#Region"/>
    <rdfs:label>Nación</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Provincia">
    <rdfs:subClassOf rdf:resource="#Region"/>
    <rdfs:label>Provincia</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Localidad">
    <rdfs:subClassOf rdf:resource="#Region"/>
    <rdfs:label>Localidad</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="#CapitalRegional">
    <rdfs:subClassOf rdf:resource="#Localidad"/>
    <rdfs:label>Capital Regional</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="#LimiteNatural">
    <rdfs:label>Límite Natural</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Clima">
    <rdfs:label>Clima</rdfs:label>
  </rdfs:Class>

  <!-- PROPIEDADES DE OBJETO ########################################### -->
  <rdf:Property rdf:about="#formaParteDe">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="#Region"/>
    <rdfs:label>forma parte de</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="#poseeCapital">
    <rdfs:domain rdf:resource="#Nacion"/>
    <rdfs:range rdf:resource="#CapitalRegional"/>
    <rdfs:label>posee capital</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="#tieneLimiteNatural">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="#LimiteNatural"/>
    <rdfs:label>tiene límite natural</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="#presentaClima">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="#Clima"/>
    <rdfs:label>presenta clima</rdfs:label>
  </rdf:Property>

  <!-- PROPIEDADES DE TIPO DE DATOS ################################################ -->
  <rdf:Property rdf:about="#nombreOficial">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>nombre oficial</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="#habitantes">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>habitantes</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="#latitud">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>latitud</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="#longitud">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>longitud</rdfs:label>
  </rdf:Property>

  <!-- INSTANCIAS ################################################## -->
  <geo:Nacion rdf:about="#Chile">
    <geo:nombreOficial>República de Chile</geo:nombreOficial>
    <geo:habitantes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19100000</geo:habitantes>
    <geo:poseeCapital rdf:resource="#Santiago"/>
    <geo:presentaClima rdf:resource="#Mediterraneo"/>
  </geo:Nacion>

  <geo:CapitalRegional rdf:about="#Santiago">
    <geo:nombreOficial>Santiago de Chile</geo:nombreOficial>
    <geo:latitud rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-33.45</geo:latitud>
    <geo:longitud rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-70.66</geo:longitud>
  </geo:CapitalRegional>

  <geo:LimiteNatural rdf:about="#CordilleraAndes">
    <geo:nombreOficial>Cordillera de los Andes</geo:nombreOficial>
  </geo:LimiteNatural>

  <geo:Clima rdf:about="#Mediterraneo">
    <geo:nombreOficial>Clima Mediterráneo</geo:nombreOficial>
  </geo:Clima>
</rdf:RDF>