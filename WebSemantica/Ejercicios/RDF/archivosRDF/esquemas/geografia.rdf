<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF 
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:geo="http://example.org/ontologia/geografia#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xml:base="http://example.org/ontologia/geografia#">

  <!-- ============================
       CLASES
  ===============================-->
  <rdfs:Class rdf:about="#Region"/>
  <rdfs:Class rdf:about="#Nacion">
    <rdfs:subClassOf rdf:resource="#Region"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="#Provincia">
    <rdfs:subClassOf rdf:resource="#Region"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="#Localidad">
    <rdfs:subClassOf rdf:resource="#Region"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="#CapitalRegional">
    <rdfs:subClassOf rdf:resource="#Localidad"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="#LimiteNatural"/>
  <rdfs:Class rdf:about="#Clima"/>

  <!-- ============================
       PROPIEDADES DE OBJETO
  ===============================-->
  <rdf:Property rdf:about="#formaParteDe">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="#Region"/>
  </rdf:Property>

  <rdf:Property rdf:about="#poseeCapital">
    <rdfs:domain rdf:resource="#Nacion"/>
    <rdfs:range rdf:resource="#CapitalRegional"/>
  </rdf:Property>

  <rdf:Property rdf:about="#tieneLimiteNatural">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="#LimiteNatural"/>
  </rdf:Property>

  <rdf:Property rdf:about="#presentaClima">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="#Clima"/>
  </rdf:Property>

  <!-- ============================
       PROPIEDADES DE DATOS
  ===============================-->
  <rdf:Property rdf:about="#nombreOficial">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>

  <rdf:Property rdf:about="#habitantes">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Property>

  <rdf:Property rdf:about="#latitud">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Property>

  <rdf:Property rdf:about="#longitud">
    <rdfs:domain rdf:resource="#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Property>


  <!-- ============================
       INSTANCIAS
  ===============================-->

  <!-- Nación -->
  <geo:Nacion rdf:about="#Chile">
    <geo:nombreOficial>República de Chile</geo:nombreOficial>
    <geo:habitantes rdf:datatype="xsd:integer">19100000</geo:habitantes>
    <geo:poseeCapital rdf:resource="#Santiago"/>
    <geo:presentaClima rdf:resource="#Mediterraneo"/>
    <geo:tieneLimiteNatural rdf:resource="#CordilleraAndes"/>
  </geo:Nacion>

  <!-- Nación adicional -->
  <geo:Nacion rdf:about="#Argentina">
    <geo:nombreOficial>República Argentina</geo:nombreOficial>
    <geo:habitantes rdf:datatype="xsd:integer">45700000</geo:habitantes>
    <geo:poseeCapital rdf:resource="#BuenosAires"/>
    <geo:presentaClima rdf:resource="#Templado"/>
    <geo:tieneLimiteNatural rdf:resource="#CordilleraAndes"/>
  </geo:Nacion>

  <!-- Capitales regionales -->
  <geo:CapitalRegional rdf:about="#Santiago">
    <geo:nombreOficial>Santiago de Chile</geo:nombreOficial>
    <geo:latitud rdf:datatype="xsd:float">-33.45</geo:latitud>
    <geo:longitud rdf:datatype="xsd:float">-70.66</geo:longitud>
  </geo:CapitalRegional>

  <geo:CapitalRegional rdf:about="#BuenosAires">
    <geo:nombreOficial>Buenos Aires</geo:nombreOficial>
    <geo:latitud rdf:datatype="xsd:float">-34.60</geo:latitud>
    <geo:longitud rdf:datatype="xsd:float">-58.38</geo:longitud>
  </geo:CapitalRegional>

  <!-- Provincias -->
  <geo:Provincia rdf:about="#Valparaiso">
    <geo:nombreOficial>Valparaíso</geo:nombreOficial>
    <geo:formaParteDe rdf:resource="#Chile"/>
    <geo:presentaClima rdf:resource="#Mediterraneo"/>
  </geo:Provincia>

  <geo:Provincia rdf:about="#Mendoza">
    <geo:nombreOficial>Mendoza</geo:nombreOficial>
    <geo:formaParteDe rdf:resource="#Argentina"/>
    <geo:presentaClima rdf:resource="#Templado"/>
  </geo:Provincia>

  <!-- Localidades -->
  <geo:Localidad rdf:about="#VinaDelMar">
    <geo:nombreOficial>Viña del Mar</geo:nombreOficial>
    <geo:formaParteDe rdf:resource="#Valparaiso"/>
  </geo:Localidad>

  <geo:Localidad rdf:about="#GodoyCruz">
    <geo:nombreOficial>Godoy Cruz</geo:nombreOficial>
    <geo:formaParteDe rdf:resource="#Mendoza"/>
  </geo:Localidad>

  <!-- Límites naturales -->
  <geo:LimiteNatural rdf:about="#CordilleraAndes">
    <geo:nombreOficial>Cordillera de los Andes</geo:nombreOficial>
  </geo:LimiteNatural>

  <geo:LimiteNatural rdf:about="#RíoBioBio">
    <geo:nombreOficial>Río Biobío</geo:nombreOficial>
  </geo:LimiteNatural>

  <!-- Climas -->
  <geo:Clima rdf:about="#Mediterraneo">
    <geo:nombreOficial>Clima Mediterráneo</geo:nombreOficial>
  </geo:Clima>

  <geo:Clima rdf:about="#Templado">
    <geo:nombreOficial>Clima Templado</geo:nombreOficial>
  </geo:Clima>

</rdf:RDF>
