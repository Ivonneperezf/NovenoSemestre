    <lib:Autor rdf:about="http://example.org/biblioteca#EmilyBronte">
        <lib:nombre>Emily Brontë</lib:nombre>
        <lib:fechaNac rdf:datatype="xsd:date">1818-07-30</lib:fechaNac>
        <lib:afiliacion>Escritora británica</lib:afiliacion>
    </lib:Autor>

    <!-- ==================== INSTANCIAS - EDITORIALES ==================== -->

    <lib:Editorial rdf:about="http://example.org/biblioteca#UmbrielEditores">
        <lib:nombre>Umbriel Editores</lib:nombre>
        <lib:direccion>Barcelona, España</lib:direccion>
    </lib:Editorial>

    <lib:Editorial rdf:about="http://example.org/biblioteca#NubeDeTinta">
        <lib:nombre>Nube de Tinta</lib:nombre>
        <lib:direccion>Barcelona, España</lib:direccion>
    </lib:Editorial>

    <lib:Editorial rdf:about="http://example.org/biblioteca#SumaDeLetras">
        <lib:nombre>Suma de Letras</lib:nombre>
        <lib:direccion>Madrid, España</lib:direccion>
    </lib:Editorial>

