<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:lib="http://example.org/biblioteca#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <!-- ==================== CLASES ==================== -->
    
    <!-- Clase Libro -->
    <rdfs:Class rdf:about="http://example.org/biblioteca#Libro">
        <rdfs:label xml:lang="es">Libro</rdfs:label>
        <rdfs:comment xml:lang="es">Representa un libro en la biblioteca</rdfs:comment>
    </rdfs:Class>

    <!-- Clase Autor -->
    <rdfs:Class rdf:about="http://example.org/biblioteca#Autor">
        <rdfs:label xml:lang="es">Autor</rdfs:label>
        <rdfs:comment xml:lang="es">Representa un autor de libros</rdfs:comment>
    </rdfs:Class>

    <!-- Clase Editorial -->
    <rdfs:Class rdf:about="http://example.org/biblioteca#Editorial">
        <rdfs:label xml:lang="es">Editorial</rdfs:label>
        <rdfs:comment xml:lang="es">Representa una casa editorial</rdfs:comment>
    </rdfs:Class>

    <!-- ==================== PROPIEDADES DE LIBRO ==================== -->
    
    <!-- Propiedad: titulo -->
    <rdf:Property rdf:about="http://example.org/biblioteca#titulo">
        <rdfs:label xml:lang="es">título</rdfs:label>
        <rdfs:comment xml:lang="es">El título del libro</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: isbn -->
    <rdf:Property rdf:about="http://example.org/biblioteca#isbn">
        <rdfs:label xml:lang="es">ISBN</rdfs:label>
        <rdfs:comment xml:lang="es">Número estándar internacional de libro</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: resumen -->
    <rdf:Property rdf:about="http://example.org/biblioteca#resumen">
        <rdfs:label xml:lang="es">resumen</rdfs:label>
        <rdfs:comment xml:lang="es">Breve descripción del contenido del libro</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: categoria -->
    <rdf:Property rdf:about="http://example.org/biblioteca#categoria">
        <rdfs:label xml:lang="es">categoría</rdfs:label>
        <rdfs:comment xml:lang="es">Género o categoría literaria del libro</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: paginas -->
    <rdf:Property rdf:about="http://example.org/biblioteca#paginas">
        <rdfs:label xml:lang="es">páginas</rdfs:label>
        <rdfs:comment xml:lang="es">Número de páginas del libro</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </rdf:Property>

    <!-- Propiedad: edicion -->
    <rdf:Property rdf:about="http://example.org/biblioteca#edicion">
        <rdfs:label xml:lang="es">edición</rdfs:label>
        <rdfs:comment xml:lang="es">Número de edición del libro</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </rdf:Property>

    <!-- Propiedad: anioedicion -->
    <rdf:Property rdf:about="http://example.org/biblioteca#anioedicion">
        <rdfs:label xml:lang="es">año de edición</rdfs:label>
        <rdfs:comment xml:lang="es">Año en que se publicó la edición</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    </rdf:Property>

    <!-- Propiedad: tieneAutor (relación) -->
    <rdf:Property rdf:about="http://example.org/biblioteca#tieneAutor">
        <rdfs:label xml:lang="es">tiene autor</rdfs:label>
        <rdfs:comment xml:lang="es">Relaciona un libro con su autor</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://example.org/biblioteca#Autor"/>
    </rdf:Property>

    <!-- Propiedad: publicadoPor (relación) -->
    <rdf:Property rdf:about="http://example.org/biblioteca#publicadoPor">
        <rdfs:label xml:lang="es">publicado por</rdfs:label>
        <rdfs:comment xml:lang="es">Relaciona un libro con la editorial que lo publicó</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Libro"/>
        <rdfs:range rdf:resource="http://example.org/biblioteca#Editorial"/>
    </rdf:Property>

    <!-- ==================== PROPIEDADES DE AUTOR ==================== -->
    
    <!-- Propiedad: nombre -->
    <rdf:Property rdf:about="http://example.org/biblioteca#nombre">
        <rdfs:label xml:lang="es">nombre</rdfs:label>
        <rdfs:comment xml:lang="es">Nombre completo del autor o editorial</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Autor"/>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Editorial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- Propiedad: fechaNac -->
    <rdf:Property rdf:about="http://example.org/biblioteca#fechaNac">
        <rdfs:label xml:lang="es">fecha de nacimiento</rdfs:label>
        <rdfs:comment xml:lang="es">Fecha de nacimiento del autor</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Autor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </rdf:Property>

    <!-- Propiedad: afiliacion -->
    <rdf:Property rdf:about="http://example.org/biblioteca#afiliacion">
        <rdfs:label xml:lang="es">afiliación</rdfs:label>
        <rdfs:comment xml:lang="es">Institución o afiliación del autor</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Autor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- ==================== PROPIEDADES DE EDITORIAL ==================== -->
    
    <!-- Propiedad: direccion -->
    <rdf:Property rdf:about="http://example.org/biblioteca#direccion">
        <rdfs:label xml:lang="es">dirección</rdfs:label>
        <rdfs:comment xml:lang="es">Ubicación geográfica de la editorial</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/biblioteca#Editorial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <!-- ==================== INSTANCIAS - LIBROS ==================== -->

    <!-- Libro 1 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#LosSieteMaridosDeEvelynHugo">
        <lib:titulo>Los siete maridos de Evelyn Hugo</lib:titulo>
        <lib:isbn>9788419030733</lib:isbn>
        <lib:resumen>Una legendaria actriz de Hollywood narra su vida, sus matrimonios y secretos ocultos a una joven periodista.</lib:resumen>
        <lib:categoria>Novela romántica / Ficción histórica</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">384</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2022</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#TaylorJenkinsReid"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#UmbrielEditores"/>
    </lib:Libro>

    <!-- Libro 2 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#BajoLaMismaEstrella">
        <lib:titulo>Bajo la misma estrella</lib:titulo>
        <lib:isbn>978-84-15594-30-5</lib:isbn>
        <lib:resumen>Dos adolescentes con cáncer se conocen en un grupo de apoyo y viven un intenso romance marcado por la enfermedad.</lib:resumen>
        <lib:categoria>Novela romántica / Juvenil</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">304</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2012</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#JohnGreen"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#NubeDeTinta"/>
    </lib:Libro>

    <!-- Libro 3 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#YoAntesDeTi">
        <lib:titulo>Yo antes de ti</lib:titulo>
        <lib:isbn>978-84-15750-80-0</lib:isbn>
        <lib:resumen>Louisa Clark se convierte en cuidadora de Will Traynor, un joven tetrapléjico, desarrollando un amor transformador.</lib:resumen>
        <lib:categoria>Novela romántica / Drama</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">496</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2014</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#JojoMoyes"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#SumaDeLetras"/>
    </lib:Libro>

    <!-- Libro 4 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#OrgulloYPrejuicio">
        <lib:titulo>Orgullo y prejuicio</lib:titulo>
        <lib:isbn>978-84-376-0494-7</lib:isbn>
        <lib:resumen>La historia de Elizabeth Bennet y el señor Darcy, marcada por malentendidos, orgullo y amor.</lib:resumen>
        <lib:categoria>Novela romántica / Clásico</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">432</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">1813</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#JaneAusten"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#AlianzaEditorial"/>
    </lib:Libro>

    <!-- Libro 5 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#UnCuentoPerfecto">
        <lib:titulo>Un cuento perfecto</lib:titulo>
        <lib:isbn>978-84-08-22645-0</lib:isbn>
        <lib:resumen>Margot huye de su vida perfecta y conoce a David, con quien vivirá una historia de amor inesperada.</lib:resumen>
        <lib:categoria>Novela romántica / Contemporánea</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">640</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2020</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#ElisabetBenavent"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#PenguinRandomHouse"/>
    </lib:Libro>

    <!-- Libro 6 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#CallMeByYourName">
        <lib:titulo>Call Me by Your Name</lib:titulo>
        <lib:isbn>978-0-374-53155-6</lib:isbn>
        <lib:resumen>En la Riviera italiana, un joven y un estudiante visitante viven un romance de verano inolvidable.</lib:resumen>
        <lib:categoria>Novela romántica / Drama</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">256</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2007</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#AndreAciman"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#FarrarStrausGiroux"/>
    </lib:Libro>

    <!-- Libro 7 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#AntesDeDiciembre">
        <lib:titulo>Antes de diciembre</lib:titulo>
        <lib:isbn>978-84-18742-41-0</lib:isbn>
        <lib:resumen>Jenna, en su primer año universitario, conoce a Jack, con quien vivirá un romance con fecha de caducidad.</lib:resumen>
        <lib:categoria>Novela romántica / Juvenil</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">448</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2022</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#JoanaMarcus"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#Crossbooks"/>
    </lib:Libro>

    <!-- Libro 8 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#PosdataTeAmo">
        <lib:titulo>Posdata: Te amo</lib:titulo>
        <lib:isbn>978-84-08-07206-4</lib:isbn>
        <lib:resumen>Holly recibe cartas de su difunto esposo que la ayudan a superar su duelo y seguir adelante.</lib:resumen>
        <lib:categoria>Novela romántica / Drama</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">384</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2004</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#CeceliaAhern"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#EdicionesB"/>
    </lib:Libro>

    <!-- Libro 9 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#LaQuimicaDelAmor">
        <lib:titulo>La química del amor</lib:titulo>
        <lib:isbn>978-84-18845-50-0</lib:isbn>
        <lib:resumen>Bee Königswasser enfrenta a su rival profesional Levi Ward mientras surge una inesperada conexión romántica.</lib:resumen>
        <lib:categoria>Novela romántica / Comedia</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">384</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2023</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#AliHazelwood"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#Contraluz"/>
    </lib:Libro>

    <!-- Libro 10 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#LaHipotesisDelAmor">
        <lib:titulo>La hipótesis del amor</lib:titulo>
        <lib:isbn>978-84-18483-96-7</lib:isbn>
        <lib:resumen>Olive Smith finge una relación con un profesor para probar un punto, pero termina involucrando sentimientos reales.</lib:resumen>
        <lib:categoria>Novela romántica / Comedia</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">384</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2021</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#AliHazelwood"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#Contraluz"/>
    </lib:Libro>

    <!-- Libro 11 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#ElInstituto">
        <lib:titulo>El Instituto</lib:titulo>
        <lib:isbn>978-84-666-6679-7</lib:isbn>
        <lib:resumen>Un grupo de niños con habilidades especiales son secuestrados y llevados a un instituto donde se realizan experimentos secretos.</lib:resumen>
        <lib:categoria>Terror / Suspenso</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">624</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2019</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#StephenKing"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#PlazaJanés"/>
    </lib:Libro>

    <!-- Libro 12 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#LosAsesinosDelEmperador">
        <lib:titulo>Los asesinos del emperador</lib:titulo>
        <lib:isbn>978-84-666-4745-1</lib:isbn>
        <lib:resumen>Una épica novela sobre el ascenso de Vespasiano y los inicios del Imperio Romano tras la caída de Nerón.</lib:resumen>
        <lib:categoria>Histórica</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">1232</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">2011</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#SantiagoPosteguillo"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#Planeta"/>
    </lib:Libro>

    <!-- Libro 13 -->
    <lib:Libro rdf:about="http://example.org/biblioteca#CumbresBorrascosas">
        <lib:titulo>Cumbres borrascosas</lib:titulo>
        <lib:isbn>978-84-376-0493-0</lib:isbn>
        <lib:resumen>Una historia intensa de amor y venganza entre Heathcliff y Catherine en los páramos de Yorkshire.</lib:resumen>
        <lib:categoria>Novela romántica / Gótica</lib:categoria>
        <lib:paginas rdf:datatype="xsd:integer">416</lib:paginas>
        <lib:edicion>1</lib:edicion>
        <lib:anioedicion rdf:datatype="xsd:gYear">1847</lib:anioedicion>
        <lib:tieneAutor rdf:resource="http://example.org/biblioteca#EmilyBronte"/>
        <lib:publicadoPor rdf:resource="http://example.org/biblioteca#AlianzaEditorial"/>
    </lib:Libro>

    <!-- ==================== INSTANCIAS - AUTORES ==================== -->

