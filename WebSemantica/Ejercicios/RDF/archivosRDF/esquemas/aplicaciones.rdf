<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:webapp="http://example.org/webapp#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <!-- ==================== CLASES PRINCIPALES ==================== -->

    <rdfs:Class rdf:about="http://example.org/webapp#WebApplication">
        <rdfs:label>Web Application</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#WebBrowser">
        <rdfs:label>Web Browser</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#WebServer">
        <rdfs:label>Web Server</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#DynamicLinkLibraries">
        <rdfs:label>Dynamic Link Libraries</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#Protocol">
        <rdfs:label>Protocol</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#DomainNameServer">
        <rdfs:label>Domain Name Server</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#ConfigurationFiles">
        <rdfs:label>Configuration Files</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#CGIProgram">
        <rdfs:label>CGI Program</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#Database">
        <rdfs:label>Database</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#HTML">
        <rdfs:label>HTML</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#ProgrammingLanguage">
        <rdfs:label>Programming Language</rdfs:label>
    </rdfs:Class>

    <!-- ==================== SUBCLASES ==================== -->

    <!-- Protocolos específicos -->
    <rdfs:Class rdf:about="http://example.org/webapp#HTTP">
        <rdfs:subClassOf rdf:resource="http://example.org/webapp#Protocol"/>
        <rdfs:label>HTTP</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#TCP">
        <rdfs:subClassOf rdf:resource="http://example.org/webapp#Protocol"/>
        <rdfs:label>TCP</rdfs:label>
    </rdfs:Class>

    <rdfs:Class rdf:about="http://example.org/webapp#IP">
        <rdfs:subClassOf rdf:resource="http://example.org/webapp#Protocol"/>
        <rdfs:label>IP</rdfs:label>
    </rdfs:Class>

    <!-- Lenguajes de programación -->
    <rdfs:Class rdf:about="http://example.org/webapp#Perl">
        <rdfs:subClassOf rdf:resource="http://example.org/webapp#ProgrammingLanguage"/>
        <rdfs:label>Perl</rdfs:label>
    </rdfs:Class>

    <!-- ==================== PROPIEDADES (RELACIONES) ==================== -->

    <rdf:Property rdf:about="http://example.org/webapp#isAccessedThrough">
        <rdfs:label>is accessed through</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#WebApplication"/>
        <rdfs:range rdf:resource="http://example.org/webapp#WebBrowser"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#runsOn">
        <rdfs:label>runs on</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#WebApplication"/>
        <rdfs:range rdf:resource="http://example.org/webapp#WebServer"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#needs">
        <rdfs:label>needs</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#WebBrowser"/>
        <rdfs:range rdf:resource="http://example.org/webapp#DynamicLinkLibraries"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#communicatesUsing">
        <rdfs:label>communicates using</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#WebBrowser"/>
        <rdfs:range rdf:resource="http://example.org/webapp#Protocol"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#serverCommunicatesUsing">
        <rdfs:label>communicates using</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#WebServer"/>
        <rdfs:range rdf:resource="http://example.org/webapp#Protocol"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#getHostNamesUsing">
        <rdfs:label>get host names using</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#Protocol"/>
        <rdfs:range rdf:resource="http://example.org/webapp#DomainNameServer"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#isConfiguredBy">
        <rdfs:label>is configured by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#WebServer"/>
        <rdfs:range rdf:resource="http://example.org/webapp#ConfigurationFiles"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#launches">
        <rdfs:label>launches</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#WebServer"/>
        <rdfs:range rdf:resource="http://example.org/webapp#CGIProgram"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#isWrittenIn">
        <rdfs:label>is written in</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#CGIProgram"/>
        <rdfs:range rdf:resource="http://example.org/webapp#ProgrammingLanguage"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#formatsResultsIn">
        <rdfs:label>formats results in</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#CGIProgram"/>
        <rdfs:range rdf:resource="http://example.org/webapp#HTML"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#getResultsFrom">
        <rdfs:label>get results from</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#CGIProgram"/>
        <rdfs:range rdf:resource="http://example.org/webapp#Database"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://example.org/webapp#databaseIsConfiguredBy">
        <rdfs:label>is configured by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/webapp#Database"/>
        <rdfs:range rdf:resource="http://example.org/webapp#ConfigurationFiles"/>
    </rdf:Property>

    <!-- ==================== INSTANCIAS DE EJEMPLO ==================== -->

    <!-- Instancia de aplicación web -->
    <webapp:WebApplication rdf:about="http://example.org/webapp/instance/myWebApp">
        <rdfs:label>My Web Application</rdfs:label>
        <webapp:isAccessedThrough rdf:resource="http://example.org/webapp/instance/browser1"/>
        <webapp:runsOn rdf:resource="http://example.org/webapp/instance/server1"/>
    </webapp:WebApplication>

    <!-- Instancia de navegador -->
    <webapp:WebBrowser rdf:about="http://example.org/webapp/instance/browser1">
        <rdfs:label>Web Browser Instance</rdfs:label>
        <webapp:needs rdf:resource="http://example.org/webapp/instance/dll1"/>
        <webapp:communicatesUsing rdf:resource="http://example.org/webapp/instance/protocols"/>
    </webapp:WebBrowser>

    <!-- Instancia de servidor web -->
    <webapp:WebServer rdf:about="http://example.org/webapp/instance/server1">
        <rdfs:label>Web Server Instance</rdfs:label>
        <webapp:serverCommunicatesUsing rdf:resource="http://example.org/webapp/instance/protocols"/>
        <webapp:isConfiguredBy rdf:resource="http://example.org/webapp/instance/config1"/>
        <webapp:launches rdf:resource="http://example.org/webapp/instance/cgi1"/>
    </webapp:WebServer>

    <!-- Instancia de librerías dinámicas -->
    <webapp:DynamicLinkLibraries rdf:about="http://example.org/webapp/instance/dll1">
        <rdfs:label>Dynamic Link Libraries Instance</rdfs:label>
    </webapp:DynamicLinkLibraries>

    <!-- Instancia de protocolos -->
    <webapp:Protocol rdf:about="http://example.org/webapp/instance/protocols">
        <rdfs:label>HTTP, TCP/IP</rdfs:label>
        <webapp:getHostNamesUsing rdf:resource="http://example.org/webapp/instance/dns1"/>
    </webapp:Protocol>

    <!-- Instancia de DNS -->
    <webapp:DomainNameServer rdf:about="http://example.org/webapp/instance/dns1">
        <rdfs:label>Domain Name Server Instance</rdfs:label>
    </webapp:DomainNameServer>

    <!-- Instancia de archivos de configuración -->
    <webapp:ConfigurationFiles rdf:about="http://example.org/webapp/instance/config1">
        <rdfs:label>Configuration Files Instance</rdfs:label>
    </webapp:ConfigurationFiles>

    <!-- Instancia de programa CGI -->
    <webapp:CGIProgram rdf:about="http://example.org/webapp/instance/cgi1">
        <rdfs:label>CGI Program Instance</rdfs:label>
        <webapp:isWrittenIn rdf:resource="http://example.org/webapp/instance/perl"/>
        <webapp:formatsResultsIn rdf:resource="http://example.org/webapp/instance/html1"/>
        <webapp:getResultsFrom rdf:resource="http://example.org/webapp/instance/db1"/>
    </webapp:CGIProgram>

    <!-- Instancia de base de datos -->
    <webapp:Database rdf:about="http://example.org/webapp/instance/db1">
        <rdfs:label>Database Instance</rdfs:label>
        <webapp:databaseIsConfiguredBy rdf:resource="http://example.org/webapp/instance/config1"/>
    </webapp:Database>

    <!-- Instancia de HTML -->
    <webapp:HTML rdf:about="http://example.org/webapp/instance/html1">
        <rdfs:label>HTML Output</rdfs:label>
    </webapp:HTML>

    <!-- Instancia de Perl -->
    <webapp:Perl rdf:about="http://example.org/webapp/instance/perl">
        <rdfs:label>Perl Language</rdfs:label>
    </webapp:Perl>

</rdf:RDF>
