    <rdf:Description rdf:about="http://example.org/peliculas#GabrielLuna"><rdf:type rdf:resource="pel:Actor"/></rdf:Description>

    <rdf:Description rdf:about="http://example.org/peliculas#TheoJames"><rdf:type rdf:resource="pel:Actor"/></rdf:Description>
