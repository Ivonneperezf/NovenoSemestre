<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:pel="http://example.org/peliculas#">

    <!-- Película 1 -->
    <rdf:Description rdf:about="http://example.org/peliculas#MisionImposibleSentenciaFinal">
        <pel:titulo>Misión Imposible: Sentencia final</pel:titulo>
        <pel:fechaEstreno rdf:datatype="xsd:date">2025-05-23</pel:fechaEstreno>
        <pel:director rdf:resource="http://example.org/peliculas#ChristopherMcQuarrie"/>

        <pel:generos>
            <rdf:Bag>
                <rdf:li>Acción</rdf:li>
                <rdf:li>Espionaje</rdf:li>
            </rdf:Bag>
        </pel:generos>

        <pel:reparto>
            <rdf:Bag>
                <rdf:li rdf:resource="http://example.org/peliculas#TomCruise"/>
                <rdf:li rdf:resource="http://example.org/peliculas#VingRhames"/>
                <rdf:li rdf:resource="http://example.org/peliculas#SimonPegg"/>
                <rdf:li rdf:resource="http://example.org/peliculas#VanessaKirby"/>
            </rdf:Bag>
        </pel:reparto>

        <pel:resumen>Octava entrega de la saga, con Ethan Hunt enfrentándose a una peligrosa misión final.</pel:resumen>
        <pel:distribuidora>Paramount Pictures</pel:distribuidora>
        <pel:paisOrigen>Estados Unidos</pel:paisOrigen>
    </rdf:Description>

