    <!-- Película 1 -->
    <rdf:Description rdf:about="http://example.org/peliculas#MisionImposibleSentenciaFinal">
        <pel:titulo>Misión Imposible: Sentencia final</pel:titulo>
        <pel:fechaEstreno>2025-05-23</pel:fechaEstreno>
        <pel:director rdf:resource="http://example.org/peliculas#ChristopherMcQuarrie"/>
        <pel:generos rdf:parseType="Collection">
            <pel:genero>Acción</pel:genero>
            <pel:genero>Espionaje</pel:genero>
        </pel:generos>
        <pel:reparto rdf:parseType="Collection">
            <pel:actor rdf:resource="http://example.org/peliculas#TomCruise"/>
            <pel:actor rdf:resource="http://example.org/peliculas#VingRhames"/>
            <pel:actor rdf:resource="http://example.org/peliculas#SimonPegg"/>
            <pel:actor rdf:resource="http://example.org/peliculas#VanessaKirby"/>
        </pel:reparto>
        <pel:resumen>Octava entrega de la saga, con Ethan Hunt enfrentándose a una peligrosa misión final.</pel:resumen>
        <pel:distribuidora>Paramount Pictures</pel:distribuidora>
        <pel:paisOrigen>Estados Unidos</pel:paisOrigen>
    </rdf:Description>

